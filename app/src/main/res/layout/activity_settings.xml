<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/SettingsSection" android:text="@string/sec_controls" />
    <LinearLayout style="@style/SettingsCard">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tiltbuttons" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_tiltbuttons" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/tiltbtns"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/hapticfeedback" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_hapticfeedback" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/hapticfeedback"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/padsize" android:textColor="@color/white" android:textSize="16sp" />
            <SeekBar android:id="@+id/padsize" android:layout_width="match_parent"
                android:layout_height="40dp" android:max="60" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:text="@string/sec_display" />
    <LinearLayout style="@style/SettingsCard">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/customfonts" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_cstmfnts" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/cstmfnts"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/showmessages" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_showmessages" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/showmessages"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/remainingballssettings" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_remainingballs" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/remainingballs"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:text="@string/sec_sound" />
    <LinearLayout style="@style/SettingsCard">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/soundfx" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_soundfx" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/soundfx"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/music" android:textColor="@color/white" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/desc_music" android:textColor="@color/description_grey" android:textSize="13sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/music"
                android:layout_width="wrap_content" android:layout_height="48dp" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/vol_effects" android:textColor="@color/white" android:textSize="16sp" />
            <SeekBar android:id="@+id/soundvol" android:layout_width="match_parent"
                android:layout_height="40dp" android:max="100" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/vol_music" android:textColor="@color/white" android:textSize="16sp" />
            <SeekBar android:id="@+id/musicvol" android:layout_width="match_parent"
                android:layout_height="40dp" android:max="100" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/verstxtv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/description_grey"
        android:textSize="13sp" />
</LinearLayout>
</ScrollView>
