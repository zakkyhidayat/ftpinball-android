<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/black">

    <!-- The table's own sidebar painting behind the top panel. Height is set in code -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Below the table: flippers, plunger and tilt. Height is set in code to match the table margin -->
    <LinearLayout
        android:id="@+id/bottompanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/left"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_height"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:background="@drawable/bg_pad"
                android:text="@string/left"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/right"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_height"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:background="@drawable/bg_pad"
                android:text="@string/right"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiltrow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tilt_height"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tilt_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nudge"
                android:text="@string/tilt_left"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tilt_bottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nudge"
                android:text="@string/tilt_center"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tilt_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nudge"
                android:text="@string/tilt_right"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hold to shoot: sits just below the floating shooter window, top margin set in code -->
    <com.fexed.spacecadetpinball.PlungerButton
        android:id="@+id/plunger"
        android:layout_width="@dimen/plunger_button_size"
        android:layout_height="@dimen/plunger_button_size"
        android:background="@drawable/bg_plunger_round"
        android:padding="4dp"
        android:text="@string/hold_to_shoot"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Paused: hides the table -->
    <FrameLayout
        android:id="@+id/pauseoverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/pauseart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.2"
            android:text="@string/pause"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="72dp"
            android:text="@string/pause_hint"
            android:textColor="@color/description_grey"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Above the table: score and balls, status, then the four action buttons -->
    <LinearLayout
        android:id="@+id/toppanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exitbtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/menutitle"
                android:src="@drawable/ic_exit" />

            <ImageButton
                android:id="@+id/replay"
                android:layout_width="0dp"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/restarttitle"
                android:src="@drawable/replay" />

            <ImageButton
                android:id="@+id/playpause"
                android:layout_width="0dp"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/pause"
                android:src="@drawable/pause" />

            <ImageButton
                android:id="@+id/settingsbtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_pill"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/settings" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtscore"
                android:layout_width="190dp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeTextType="uniform"
                android:layout_height="48dp"
                android:background="@drawable/bg_hud_score"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="28sp"
                tools:text="10000000" />

            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/ballstxt"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_hud_balls"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="Ball 1" />
        </LinearLayout>

        <TextView
            android:id="@+id/infotxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="Awaiting Deployment" />

        <TextView
            android:id="@+id/missiontxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="mission text" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
