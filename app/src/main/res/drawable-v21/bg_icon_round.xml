<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_light">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/icon_fill_pressed" />
                    <stroke android:width="1dp" android:color="@color/icon_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/icon_fill" />
                    <stroke android:width="1dp" android:color="@color/icon_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
